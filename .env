
LLM_PROVIDER=groq

GROQ_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Option C: Google Gemini free tier --------------------------------------
# Free key: https://aistudio.google.com/apikey  and set LLM_PROVIDER=gemini
GEMINI_API_KEY=

FAST_MODEL=llama-3.1-8b-instant
SMART_MODEL=llama-3.1-8b-instant

LANGFUSE_PUBLIC_KEY=pk-lf-67b68526-75d6-439d-8dd6-817dc1fc80e5
LANGFUSE_SECRET_KEY=sk-lf-575055f2-98ac-4815-9aa5-72dbaa95a40f
LANGFUSE_HOST=https://cloud.langfuse.com

WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENABLED=true

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=8          # how many chunks the vector search returns
RERANK_TOP_N=4            # how many survive the reranker and reach the LLM
MIN_RELEVANCE_SCORE=0.15  # below this we say "I don't know" instead of guessing
RERANKER=auto             # auto | flashrank | lexical | none

# -----------------------------------------------------------------------------
# 6. APP
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_AGENT_STEPS=6         # safety limit on the autonomous tool-calling loop
